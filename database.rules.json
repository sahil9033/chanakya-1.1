{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['lastSeen', 'createdAt'])"
        },
        "sessions": {
          "$sessionId": {
            ".validate": "newData.hasChildren(['id', 'title', 'filter', 'model', 'updatedAt', 'messages'])"
          }
        }
      }
    }
  }
}
